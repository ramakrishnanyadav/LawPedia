# Lawpedia Environment Variables Example Template
# Copy this file to .env for local development. NEVER commit your real .env to git.

# Backend API Configuration
LAWPEDIA_SECRET_KEY=your-production-secret-key-here
DEBUG=True
PORT=8000

# Firebase Authentication Configuration (Replace with your Firebase Project Credentials)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Multi-Tenant & Safety Settings
DEFAULT_TENANT_ID=tenant_lawpedia_demo
MAX_UPLOAD_SIZE_MB=25
MIN_CONFIDENCE_THRESHOLD=0.30

# ─── DEMO MODE (Local Dev Only) ────────────────────────────────────────────────
# SECURITY WARNING: Demo mode bypasses Firebase authentication using a static
# bearer token. This is ONLY safe for local development or dedicated demo servers.
#
# ✅  Set to "true" for local dev/demo (use render-demo.yaml for Render demos).
# ❌  NEVER set to "true" on a production service exposed to real users.
#     The production render.yaml already sets this to "false".
#
# Default: "false" — leave blank or remove both lines for production.
LAWPEDIA_DEMO_MODE=true
LAWPEDIA_DEMO_TOKEN=lawpedia_demo_token_2026
# ───────────────────────────────────────────────────────────────────────────────

# Optional: LLM API Keys (leave blank to use grounded template-only fallback)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: Lightweight embedding mode (recommended on free Render tier)
# LAWPEDIA_LIGHTWEIGHT_MODE=true
